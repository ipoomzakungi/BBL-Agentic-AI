AZURE_OPENAI_ENDPOINT=https://your-api-gateway.example/llm/
AZURE_OPENAI_API_KEY=replace-with-your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Set to 0 to disable automatic retries after HTTP 429.
RATE_LIMIT_MAX_RETRIES=2
# Fallback only when the gateway sends no retry/reset header.
RATE_LIMIT_RETRY_SECONDS=30
# Set to 0 to disable the proactive wait between --demo questions.
DEMO_DELAY_SECONDS=60
